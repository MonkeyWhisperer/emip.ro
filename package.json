{
  "name": "emip-ro",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts --dev",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && npm run knowledge:export",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "knowledge:export": "node scripts/export-site-text.ts",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "admin:hash-password": "node server/scripts/hash-password.ts",
    "db:reseed": "node --env-file-if-exists=.env server/scripts/reseed.ts",
    "ai:reset": "node --env-file-if-exists=.env server/scripts/ai-reset.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "openai": "^7.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
