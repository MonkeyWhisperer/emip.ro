# Copy to .env (never commit .env).

# --- Admin panel (single user) ---
ADMIN_EMAIL=admin@emip.ro
# Generate with: npm run admin:hash-password
ADMIN_PASSWORD_HASH=

# --- AI assistant (chat panel on the site) ---
# Server-side only; never exposed to the browser. Without it the assistant is hidden.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# Reasoning effort (none, minimal, low, medium, high); unset = the model's default.
# OPENAI_REASONING_EFFORT=
# Token budgets per UTC day (input + output tokens; a question costs about 7,000).
# Whole site:
# AI_DAILY_TOKEN_LIMIT=3000000
# Per visitor (IP address, IPv6 per /64):
# AI_IP_DAILY_TOKEN_LIMIT=200000

# --- Server ---
# Public site URL: sitemap, canonical links and link previews, and the assistant's knowledge documents.
# SITE_URL=https://www.emip.ro
# PORT=3000
# Where the SQLite database and uploaded files are stored. Back this folder up.
# DATA_DIR=./data
# Number of reverse proxies in front of the server (nginx, Caddy, a PaaS router), usually 1.
# Client IPs for the rate limits (chat, forms, login) then come from X-Forwarded-For.
# TRUST_PROXY=1
# Address to listen on. Default: 0.0.0.0, or 127.0.0.1 when TRUST_PROXY is set (so X-Forwarded-For
# cannot be forged by connecting directly). Set 0.0.0.0 when the proxy connects over a network
# (containers, PaaS) and the port is reachable only through it.
# HOST=
